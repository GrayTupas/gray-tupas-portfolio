      "name": "Get Transcript"
    },
    {
      "parameters": {
        "jsCode": "const meeting = $json.data.transcript;\n\nconst cleanTranscript = meeting.sentences\n  .map(sentence => `${sentence.speaker_name}: ${sentence.text}`)\n  .join('\\n\\n');\n\nreturn [\n  {\n    json: {\n      meeting_id: meeting.id,\n      meeting_title: meeting.title,\n      transcript_url: meeting.transcript_url,\n      clean_transcript: cleanTranscript\n    }\n  }\n];"
      },
