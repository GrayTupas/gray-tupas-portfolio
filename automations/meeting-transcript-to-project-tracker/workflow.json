        "jsonBody": "={{\n  {\n    query: `\n      query Transcript($transcriptId: String!) {\n        transcript(id: $transcriptId) {\n          id\n          title\n          transcript_url\n          summary {\n            overview\n            short_summary\n            action_items\n          }\n          sentences {\n            speaker_name\n            text\n          }\n        }\n      }\n    `,\n    variables: {\n      transcriptId: $json.body.meeting_id\n    }\n  }\n}}",
        "options": {}
      },
